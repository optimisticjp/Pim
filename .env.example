# Public Supabase connection values. Safe to expose to browser code; RLS remains the security boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional public override. The current Pim workers.dev Turnstile site key is also
# compiled as a safe public fallback so Cloudflare builds do not depend on this.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Private Turnstile values belong in Supabase Edge Function secrets, never here:
# TURNSTILE_SECRET_KEY
# TURNSTILE_ALLOWED_HOSTNAMES

# Do not commit service-role keys, database passwords, R2 secrets, Turnstile secrets,
# or other private credentials.
